PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/service-marketplace
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30d
# Stripe (platform-only payments)
# Required for checkout in development/test mode:
STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Optional (only needed if you enable Stripe Connect OAuth flows)
# STRIPE_CONNECT_TEST_CLIENT_ID=ca_...
FRONTEND_URL=http://localhost:3000
